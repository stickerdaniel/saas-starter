{
	// SvelteKit writes this base config (paths, generated types, required compiler options)
	// during sync. It allows explicit .ts specifiers rather than rewriting them, which this
	// noEmit, Vite-built app relies on.
	"extends": "$app/tsconfig",
	"files": ["scripts/windows-job.ts", "scripts/check-table-scroll.ts"],
	"compilerOptions": {
		"sourceMap": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"declaration": true,
		"declarationMap": true
	},
	// The base config sets no include/exclude, so these replace the lists SvelteKit 2
	// generated: the app sources and the Vite config that imports the build scripts.
	"include": ["src/**/*.js", "src/**/*.ts", "src/**/*.svelte", "vite.config.ts"],
	"exclude": [
		"node_modules/**",
		"references/**",
		"src/service-worker",
		"packages/create-saas-starter/**",
		"src/lib/convex/**"
	]
}
