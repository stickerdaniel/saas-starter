{
	"name": "create-saas-starter",
	"version": "0.1.0",
	"description": "Create a secure SaaS Starter project",
	"license": "MIT",
	"type": "module",
	"private": false,
	"bin": {
		"create-saas-starter": "dist/index.js"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=22.16.0",
		"bun": ">=1.3.9"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"knip": "knip",
		"build": "bun scripts/build.ts",
		"prepack": "bun run build",
		"test:packed": "bun run build && bun scripts/test-packed.ts"
	},
	"devDependencies": {
		"@types/node": "26.4.1",
		"knip": "6.26.0",
		"typescript": "6.0.3",
		"vitest": "4.1.10"
	},
	"dependencies": {
		"@clack/prompts": "1.7.0",
		"tar": "7.5.22"
	}
}
