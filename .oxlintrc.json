{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"jsPlugins": ["oxlint-plugin-convex"],
	"ignorePatterns": [
		"scratch/**",
		"**/node_modules/**",
		"**/_generated/**",
		"**/references/**",
		"scripts/english-policy/pr-metadata.bundle.mjs"
	],
	"rules": {
		"convex/no-invalid-module-path": "error",
		"typescript/array-type": ["error", { "default": "array-simple" }],
		"typescript/consistent-type-imports": ["error", { "disallowTypeAnnotations": true }],
		"no-restricted-imports": [
			"error",
			{
				"paths": [
					{ "name": "zod", "message": "zod is not a dependency. Validate with effect/Schema." }
				],
				"patterns": [
					{ "group": ["zod/*"], "message": "zod is not a dependency. Validate with effect/Schema." }
				]
			}
		]
	}
}
