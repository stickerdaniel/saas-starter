{
	"name": "saas-starter",
	"version": "0.1.0",
	"templateSetupVersion": 1,
	"license": "MIT",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*",
		"#blocks/*": "./src/blocks/*",
		"#static/*": "./static/*"
	},
	"scripts": {
		"dev": "bun scripts/dev.ts",
		"dev:frontend": "bun scripts/dev.ts",
		"dev:backend:cloud": "bun scripts/dev-convex-cloud.ts",
		"dev:cloud": "bun scripts/dev-cloud.ts",
		"dev:test": "VARLOCK_ENV=test bun scripts/dev-test.ts",
		"generate": "bun run generate:content && bun scripts/generate-convex.ts",
		"generate:content": "bun scripts/generate-authored-content.ts",
		"install:cli": "bun install --cwd packages/create-saas-starter --frozen-lockfile",
		"postinstall": "bun run install:cli && bun run generate:content && bun svelte-kit sync && varlock codegen && varlock codegen --path .env-convex.schema && bun run build:emails",
		"prebuild": "bun run generate:content && bun run build:emails",
		"build": "bun scripts/build.ts",
		"postbuild": "bun scripts/check-build-output.ts",
		"start": "node build",
		"generate:logos": "bun scripts/generate-logos.ts",
		"generate:og-image-url": "bun scripts/generate-og-image-url.ts",
		"build:emails": "bun run generate:logos && bun scripts/build-emails.ts",
		"preview": "vite preview",
		"prepare": "husky",
		"package": "bun run generate:content && bun svelte-kit sync && svelte-package",
		"check": "bun svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo-experimental-api",
		"check:watch": "bun svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:cli": "bun run --cwd packages/create-saas-starter typecheck",
		"test:cli": "bun run --cwd packages/create-saas-starter test",
		"build:cli": "bun run --cwd packages/create-saas-starter build",
		"test:cli:packed": "bun run --cwd packages/create-saas-starter test:packed",
		"check:convex": "bun run generate:content && tsc -p src/lib/convex/tsconfig.json --noEmit",
		"check:convex-compat": "bun scripts/static-checks.ts --scope compat",
		"check:english": "bun scripts/check-english.ts",
		"build:english-policy": "bun build scripts/english-policy/pr-metadata.ts --target=bun --minify --outfile=scripts/english-policy/pr-metadata.bundle.mjs",
		"format": "prettier --write .",
		"lint": "eslint . --cache --concurrency auto && oxlint",
		"lint:convex": "oxlint",
		"knip": "knip",
		"static-checks": "bun scripts/static-checks.ts",
		"static-checks:staged": "bun scripts/static-checks.ts --staged --scope lint",
		"check:precommit": "bun run static-checks:staged && bunx varlock scan --staged",
		"test:e2e": "VARLOCK_ENV=test playwright test",
		"test:e2e:headed": "VARLOCK_ENV=test playwright test --headed",
		"test": "bun run test:e2e && bun run test:unit && bun run test:cli && bun run test:upstream-report",
		"test:unit": "bun run generate:content && vitest --run --reporter=verbose --passWithNoTests",
		"test:upstream-report": "vitest --config .agents/skills/upstream-report/scripts/vitest.config.ts --run --reporter=verbose",
		"model:eval": "bun scripts/model-eval.ts",
		"i18n:pull": "varlock run -- bun run _tolgee:pull && prettier --write src/i18n/*.json && bun run i18n:sync",
		"i18n:push": "varlock run -- bun run _tolgee:push",
		"i18n:cleanup": "varlock run -- bun run _tolgee:cleanup",
		"i18n:sync": "bun scripts/sync-locales.ts",
		"_tolgee:pull": "TOLGEE_API_KEY=$VITE_TOLGEE_API_KEY tolgee pull",
		"_tolgee:push": "TOLGEE_API_KEY=$VITE_TOLGEE_API_KEY tolgee push",
		"_tolgee:cleanup": "TOLGEE_API_KEY=$VITE_TOLGEE_API_KEY tolgee tag --filter-not-extracted --filter-tag production --tag deprecated --untag production",
		"worktree": "bun scripts/create-worktree.ts",
		"worktree:setup": "bun scripts/create-worktree.ts --setup-only",
		"worktree:prune": "bun scripts/prune-worktrees.ts",
		"setup": "bun scripts/template-setup.ts",
		"check:skills": "tsc -p .agents/skills/tsconfig.json",
		"upstream:report": "bun .agents/skills/upstream-report/scripts/upstream-relevance.ts",
		"upstream:sync": "bun .agents/skills/upstream-sync/scripts/find-fork-point.ts",
		"upstream:fork-point": "bun .agents/skills/upstream-sync/scripts/find-fork-point.ts",
		"upstream:changes": "bun .agents/skills/upstream-sync/scripts/list-upstream-changes.ts"
	},
	"packageManager": "bun@1.4.2",
	"dependencies": {
		"@ai-sdk/provider": "4.0.19",
		"@better-auth/passkey": "1.6.33",
		"@better-svelte-email/components": "2.3.0",
		"@better-svelte-email/server": "2.3.0",
		"@convex-dev/agent": "0.7.3",
		"@convex-dev/better-auth": "0.12.5",
		"@convex-dev/rate-limiter": "0.4.0",
		"@convex-dev/resend": "0.2.8",
		"@formkit/auto-animate": "0.10.0",
		"@gilhrpenner/convex-files-control": "0.5.9",
		"@jsquash/webp": "1.5.0",
		"@mmailaender/convex-better-auth-svelte": "0.9.0",
		"@openrouter/ai-sdk-provider": "3.1.0",
		"@rive-app/canvas": "2.43.1",
		"@sentry/sveltekit": "11.5.0",
		"@stickerdaniel/convex-autumn-svelte": "0.5.0",
		"@svelte-put/lockscroll": "2.0.1",
		"@tolgee/format-icu": "7.2.1",
		"@tolgee/svelte": "7.2.1",
		"@useautumn/convex": "0.0.23",
		"@varlock/cloudflare-integration": "1.6.0",
		"@varlock/vite-integration": "1.5.2",
		"@zumer/snapdom": "3.2.0",
		"@zxcvbn-ts/core": "4.2.0",
		"@zxcvbn-ts/language-common": "4.1.3",
		"@zxcvbn-ts/language-en": "4.1.1",
		"ai": "7.0.122",
		"atmn": "2.0.48",
		"autumn-js": "0.1.85",
		"better-auth": "1.6.33",
		"convex-helpers": "0.1.124",
		"convex-svelte": "0.14.0",
		"date-fns": "4.4.0",
		"konva": "10.7.0",
		"mode-watcher": "1.1.0",
		"motion-sv": "0.1.13",
		"paneforge": "1.0.2",
		"posthog-js": "1.434.18",
		"runed": "0.37.1",
		"svelte-infinite": "0.6.0",
		"svelte-konva": "1.0.1",
		"svelte-streamdown": "4.2.0",
		"svelte-toolbelt": "0.10.6",
		"svix": "2.8.0",
		"valibot": "1.5.0",
		"varlock": "1.21.1",
		"web-haptics": "0.0.6",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@convex-dev/eslint-plugin": "5.0.0",
		"@eslint/compat": "2.1.1",
		"@eslint/js": "10.0.1",
		"@internationalized/date": "3.12.4",
		"@lucide/svelte": "1.48.0",
		"@oxlint/plugins": "1.86.0",
		"@playwright/test": "1.63.0",
		"@resvg/resvg-js": "2.6.2",
		"@shadcn/lint": "0.2.0",
		"@sveltejs/adapter-auto": "8.0.0",
		"@sveltejs/adapter-cloudflare": "8.0.0",
		"@sveltejs/adapter-node": "6.0.0",
		"@sveltejs/adapter-vercel": "7.0.0",
		"@sveltejs/kit": "3.0.1",
		"@sveltejs/package": "3.0.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/oxide": "4.3.3",
		"@tailwindcss/typography": "0.5.20",
		"@tailwindcss/vite": "4.3.3",
		"@tanstack/svelte-table": "9.2.4",
		"@tanstack/table-core": "9.2.4",
		"@tolgee/cli": "2.20.0",
		"@types/node": "26.6.4",
		"@types/subset-font": "2.3.0",
		"@typescript/native": "npm:typescript@7.0.2",
		"bits-ui": "2.19.3",
		"clsx": "2.1.1",
		"convex": "1.46.0",
		"convex-vite-plugin": "0.4.0",
		"eld": "2.1.0",
		"eslint": "10.11.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.0",
		"fontless": "1.2.1",
		"globals": "17.12.0",
		"husky": "9.1.7",
		"jsdom": "29.1.1",
		"knip": "6.40.0",
		"marked": "18.0.14",
		"oxlint": "1.86.0",
		"oxlint-plugin-convex": "0.1.1",
		"parse5": "8.0.1",
		"postcss": "8.5.28",
		"prettier": "3.9.9",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"rollup-plugin-visualizer": "7.1.1",
		"spdx-license-list": "6.12.0",
		"strip-ansi": "7.2.0",
		"subset-font": "2.9.0",
		"svelte": "5.57.2",
		"svelte-check": "4.7.6",
		"svelte-eslint-parser": "1.8.1",
		"svelte-sonner": "1.2.1",
		"tailwind-merge": "3.7.0",
		"tailwind-variants": "3.3.1",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.1",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "8.3.3",
		"vite-plugin-devtools-json": "1.1.1",
		"vitest": "5.0.3",
		"wrangler": "4.148.0",
		"yaml": "2.9.1"
	},
	"patchedDependencies": {
		"oxlint-plugin-convex@0.1.1": "patches/oxlint-plugin-convex@0.1.1.patch",
		"convex-vite-plugin@0.4.0": "patches/convex-vite-plugin@0.4.0.patch",
		"svelte-check@4.7.6": "patches/svelte-check@4.7.6.patch",
		"runed@0.37.1": "patches/runed@0.37.1.patch"
	},
	"overrides": {
		"zod": "$zod",
		"@peculiar/asn1-schema": "2.10.0",
		"acorn": "8.18.0",
		"vite": "$vite",
		"convex-helpers": "$convex-helpers"
	}
}
