# @defaultSensitive=inferFromPrefix(PUBLIC_)
# @defaultRequired=infer
# @generateTsTypes(path=src/lib/convex/convex-env.d.ts)
# @redactLogs=true
# @preventLeaks=true
# ---

# ====================================
# Better Auth
# ====================================

# Secret for signing sessions and tokens
# @required @sensitive
BETTER_AUTH_SECRET=

# Versioned keyring for non-destructive secret rotation
# @optional @sensitive
BETTER_AUTH_SECRETS=

# Base URL for OAuth redirects and deep links
# @type=url @required
SITE_URL=

# ====================================
# Optional Capability Profile
# ====================================

# Local launchers own local/test. Hosted deployment scripts own preview/production.
# Absence is a legacy/bootstrap alias for production-strict validation.
# @type=enum(local, test, preview, production) @optional
CAPABILITY_PROFILE=

# ====================================
# Email System (Resend)
# ====================================

# Resend API key for transactional email delivery
# @optional @sensitive
RESEND_API_KEY=

# Sender email address for auth emails
# @optional
AUTH_EMAIL=

# Production URL for email assets (logo images, footer links)
# Must always be a public domain (email clients cannot access localhost)
# @type=url @optional
EMAIL_ASSET_URL=

# Resend webhook signing secret
# @optional @sensitive
RESEND_WEBHOOK_SECRET=

# ====================================
# Autumn Billing
# ====================================

# Autumn billing secret key
# @optional @sensitive
AUTUMN_SECRET_KEY=

# Signing secret of the Autumn webhook endpoint (/autumn-webhook)
# Admin customer emails stay off while it is unset
# @optional @sensitive
AUTUMN_WEBHOOK_SECRET=

# ====================================
# Admin Notifications
# ====================================

# IANA time zone for the times in admin customer emails, such as Europe/Berlin
# Defaults to UTC when unset or unknown
# @optional
ADMIN_TIME_ZONE=

# ====================================
# AI Support
# ====================================

# OpenRouter API key for AI-powered support chat
# @optional @sensitive
OPENROUTER_API_KEY=

# ====================================
# OAuth Providers
# ====================================

# Google OAuth
# @optional
AUTH_GOOGLE_ID=

# @optional @sensitive
AUTH_GOOGLE_SECRET=

# GitHub OAuth
# @optional
AUTH_GITHUB_ID=

# @optional @sensitive
AUTH_GITHUB_SECRET=

# ====================================
# E2E Testing
# ====================================

# Secret for test mutations (never set in production)
# @optional @sensitive
AUTH_E2E_TEST_SECRET=

# ====================================
# Preview Dev (auto-seeded on preview deployments)
# ====================================

# Password for the auto-seeded preview admin (admin@preview.dev)
# Inherited by preview deployments from the Convex project preview default
# env var: bunx convex env default set --type preview PREVIEW_ADMIN_PASSWORD
# @optional @sensitive
PREVIEW_ADMIN_PASSWORD=

# ====================================
# Local Dev (auto-generated by vite.config.ts)
# ====================================

# Flag indicating local Convex dev mode
# @type=boolean @optional
LOCAL_CONVEX_DEV=

# Seeded admin credentials for local dev
# @optional
LOCAL_SEEDED_ADMIN_EMAIL=

# @optional @sensitive
LOCAL_SEEDED_ADMIN_PASSWORD=

# @optional
LOCAL_SEEDED_ADMIN_NAME=
