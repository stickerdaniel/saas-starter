{
	"mcpServers": {
		"svelte": {
			"type": "http",
			"url": "https://mcp.svelte.dev/mcp"
		},
		"chrome-devtools": {
			"command": "bunx",
			"args": ["-y", "chrome-devtools-mcp@latest", "--no-usage-statistics"]
		},
		"svelte-devtools": {
			"command": "bunx",
			"args": ["@sveltejs/vite-devtools-svelte", "mcp"]
		},
		"posthog": {
			"type": "http",
			"url": "https://mcp.posthog.com/mcp"
		}
	}
}
